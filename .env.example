# Mini-mailer service (server-only — never prefix with NEXT_PUBLIC_)
# Base URL WITHOUT the trailing /send, e.g. https://mailer.example.com
MAILER_URL=
MAILER_API_KEY=

# Email Configuration
CONTACT_EMAIL=your_email@example.com
# Optional sender-address override passed to the mailer as `from`
FROM_EMAIL=noreply@yourdomain.com
