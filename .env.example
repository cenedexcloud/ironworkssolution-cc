# Mini-mailer service (server-only — never prefix with NEXT_PUBLIC_)
# Base URL WITHOUT the trailing /send, e.g. https://mailer.example.com
MAILER_URL=
MAILER_API_KEY=

# Email Configuration
CONTACT_EMAIL=your_email@example.com
# Optional sender-address override passed to the mailer as `from`
FROM_EMAIL=noreply@yourdomain.com

# Cloudflare Turnstile
# Site key is public and inlined into the client bundle at build time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key is server-only. When unset, the captcha check is skipped.
TURNSTILE_SECRET_KEY=
